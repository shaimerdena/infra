[Unit]
Description=Postgres Custom Service
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=devopsik_user

ExecStart=/usr/bin/docker start --attach postgres_db
ExecStop=/usr/bin/docker stop --timeout 30 postgres_db

TimeoutStopSec=40

StandardOutput=append:/var/log/postgresql-docker/output.log
StandardError=append:/var/log/postgresql-docker/error.log

Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target